#include <stdint.h>


int main(void)
{
    uint32_t *pClkCtrlReg =(uint32_t *) 0x40023830;
    uint32_t *pPortAModeReg =(uint32_t *) 0x40020000;
    uint32_t *pPortAOutReg =(uint32_t *) 0x40020014;

    //1. Enable the clock for GPIOA peripheral AHB1ENR

    *pClkCtrlReg | = 0x01;

    //2. configure IO mode as output
    // a. clearing the bits 11 and 10
    *pPortAModeReg &= 0xFFFFF3FF;
    // b. making 10th bit position as 1
    *pPortAModeReg |= 0x00000400;

    //3. Set 5th bit of ODR to make PA5 as high
    *pPortAOutReg | = 0x0020;

	while(1);
}
